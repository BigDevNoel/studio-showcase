---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	class?: string;
	aspect?: string;
	priority?: boolean;
}

const { src, alt, class: className = '', aspect = 'aspect-[4/5]', priority = false } = Astro.props;
---

<div class={`loupe-card overflow-hidden rounded-sm bg-porcelain-2 ${aspect} ${className}`}>
	<Image
		src={src}
		alt={alt}
		class="h-full w-full object-cover"
		widths={[400, 800, 1200]}
		sizes="(max-width: 768px) 100vw, 50vw"
		loading={priority ? 'eager' : 'lazy'}
	/>
</div>
