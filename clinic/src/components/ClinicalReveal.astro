---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	class?: string;
	aspect?: string;
	priority?: boolean;
	widths?: number[];
	sizes?: string;
}

const {
	src,
	alt,
	class: className = '',
	aspect = 'aspect-[4/5]',
	priority = false,
	widths = [500, 900, 1300],
	sizes = '(max-width: 768px) 100vw, 50vw',
} = Astro.props;
---

<div class={`clinical-reveal overflow-hidden rounded-sm ${aspect} ${className}`}>
	<div class="clinical-reveal-content h-full w-full">
		<Image
			src={src}
			alt={alt}
			class="h-full w-full object-cover"
			widths={widths}
			sizes={sizes}
			loading={priority ? 'eager' : 'lazy'}
		/>
	</div>
</div>
