---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} · Plumbline Studio</title>
		<meta name="description" content={description} />
		<meta property="og:title" content={`${title} · Plumbline Studio`} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="bg-paper text-ink font-body antialiased">
		<Nav />
		<main>
			<slot />
		</main>
		<Footer />
		<script>
			// Scroll-reveal for .veil-lift and .rise-in panels
			const revealEls = document.querySelectorAll('.veil-lift, .rise-in');
			if ('IntersectionObserver' in window && revealEls.length) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								io.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
				);
				revealEls.forEach((el) => io.observe(el));
			} else {
				revealEls.forEach((el) => el.classList.add('is-visible'));
			}

			// Sheet-index tab — updates the corner "current sheet" marker as the
			// user scrolls past sections carrying a data-sheet attribute.
			const sheetTab = document.getElementById('sheet-tab');
			const sheetSections = document.querySelectorAll('[data-sheet]');
			if (sheetTab && sheetSections.length && 'IntersectionObserver' in window) {
				const sio = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								const sheet = entry.target.getAttribute('data-sheet');
								const label = entry.target.getAttribute('data-sheet-label');
								if (sheet) sheetTab.textContent = label ? `${sheet} — ${label}` : sheet;
							}
						}
					},
					{ threshold: 0, rootMargin: '-45% 0px -45% 0px' }
				);
				sheetSections.forEach((el) => sio.observe(el));
			}

			// Mouse-driven tilt for .model-card
			document.querySelectorAll('.model-card').forEach((card) => {
				const inner = card.querySelector('.model-card__inner');
				if (!inner) return;
				card.addEventListener('pointermove', (e) => {
					const rect = card.getBoundingClientRect();
					const px = (e.clientX - rect.left) / rect.width - 0.5;
					const py = (e.clientY - rect.top) / rect.height - 0.5;
					inner.style.setProperty('--ry', `${px * 10}deg`);
					inner.style.setProperty('--rx', `${py * -10}deg`);
				});
				card.addEventListener('pointerleave', () => {
					inner.style.setProperty('--ry', '0deg');
					inner.style.setProperty('--rx', '0deg');
				});
			});

			// Every big/bold heading (h1/h2/h3 — never body copy) types itself
			// out, holds for 3s, clears, and retypes — forever. The heading's
			// accessible name is fixed to the full text via aria-label so
			// assistive tech always gets the complete line, independent of
			// animation state; an invisible sibling span reserves the box's
			// full wrapped size so nothing reflows as characters come and go.
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const HOLD_MS = 3000;
			const TYPE_SPEED_MS = 32;

			document.querySelectorAll<HTMLElement>('main h1, main h2, main h3').forEach((heading) => {
				const text = (heading.textContent || '').replace(/\s+/g, ' ').trim();
				if (!text) return;

				heading.setAttribute('aria-label', text);
				heading.classList.add('relative');
				heading.textContent = '';

				const reserved = document.createElement('span');
				reserved.className = 'invisible';
				reserved.setAttribute('aria-hidden', 'true');
				reserved.textContent = text;

				const overlay = document.createElement('span');
				overlay.className = 'typewriter-text absolute inset-0';
				overlay.setAttribute('aria-hidden', 'true');

				const chars = document.createElement('span');
				chars.className = 'typewriter-chars';

				const cursor = document.createElement('span');
				cursor.className = 'typewriter-cursor';

				overlay.append(chars, cursor);
				heading.append(reserved, overlay);

				if (reduceMotion) {
					chars.textContent = text;
					cursor.remove();
					return;
				}

				const runLoop = () => {
					let i = 0;
					const tick = () => {
						chars.textContent = text.slice(0, i);
						i++;
						if (i <= text.length) {
							setTimeout(tick, TYPE_SPEED_MS);
						} else {
							setTimeout(() => {
								chars.textContent = '';
								runLoop();
							}, HOLD_MS);
						}
					};
					tick();
				};

				// The hero heading rises in on load via .hero-intro; start typing
				// once that entrance finishes rather than mid-fade. Every other
				// heading has no separate entrance, so it can start right away.
				if (heading.closest('.hero-intro')) {
					heading.addEventListener('animationend', runLoop, { once: true });
				} else {
					runLoop();
				}
			});
		</script>
	</body>
</html>
