---
import { Image } from 'astro:assets';
import heroPhoto from '../assets/images/hero-luxury-living.jpg';
import velvetTexture from '../assets/images/swatch-velvet-texture.jpg';
---

<div class="hero-swatch relative aspect-[4/5] overflow-hidden rounded-sm shadow-[0_30px_60px_-20px_rgba(0,0,0,0.55)] sm:aspect-[16/10] md:aspect-[16/9]">
	<Image
		src={heroPhoto}
		alt="A marble fireplace, mirrored wall, and plush seating in a recently completed Plumbline Studio living room"
		class="absolute inset-0 h-full w-full object-cover"
		widths={[640, 1200, 1800]}
		sizes="100vw"
		loading="eager"
	/>

	<div class="swatch-cover absolute inset-0 z-10">
		<Image
			src={velvetTexture}
			alt=""
			class="h-full w-full object-cover"
			widths={[640, 1200]}
			sizes="100vw"
			loading="eager"
		/>
		<div class="swatch-fold absolute inset-0"></div>
		<svg class="stitchwork absolute inset-3 h-[calc(100%-1.5rem)] w-[calc(100%-1.5rem)] sm:inset-5 sm:h-[calc(100%-2.5rem)] sm:w-[calc(100%-2.5rem)]" viewBox="0 0 400 300" preserveAspectRatio="none" fill="none" stroke="#e3ded0" stroke-width="1.5">
			<path pathLength="1" style="--d:.1s" d="M6,6 L394,6 L394,294 L6,294 Z" vector-effect="non-scaling-stroke" />
		</svg>
	</div>

	<div class="pin-tag absolute left-5 top-5 flex items-center gap-2 sm:left-8 sm:top-8">
		<svg width="18" height="18" viewBox="0 0 18 18" class="drop-shadow-[0_3px_4px_rgba(0,0,0,0.35)]">
			<line x1="9" y1="0" x2="9" y2="5" stroke="#c9a24b" stroke-width="1.2" />
			<circle cx="9" cy="9" r="4.5" fill="#c9a24b" />
		</svg>
		<span class="ref-tag bg-vellum/95 text-ink">No. 12 · Emerald Velvet</span>
	</div>

	<div class="pin-tag absolute bottom-5 right-5 sm:bottom-8 sm:right-8">
		<span class="ref-tag bg-vellum/95 text-ink">Rennie Street, Scott&rsquo;s Addition</span>
	</div>
</div>

<style>
	.swatch-cover {
		animation: swatch-slide 0.9s cubic-bezier(0.16, 1, 0.3, 1) 1.7s forwards;
		transform-origin: left;
	}
	@keyframes swatch-slide {
		to {
			transform: translateX(102%) rotate(1deg);
		}
	}

	.swatch-fold {
		background: linear-gradient(100deg, rgba(0, 0, 0, 0.28), transparent 45%),
			linear-gradient(280deg, rgba(0, 0, 0, 0.18), transparent 55%);
		mix-blend-mode: multiply;
	}

	.stitchwork path {
		animation-duration: 1.1s;
	}

	.pin-tag {
		animation: pin-fall 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 2.5s both;
	}

	@media (prefers-reduced-motion: reduce) {
		.swatch-cover {
			animation: none;
			transform: translateX(102%);
		}
		.stitchwork path {
			animation: none;
			stroke-dashoffset: 0;
		}
		.pin-tag {
			animation: none;
		}
	}
</style>
