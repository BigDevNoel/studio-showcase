---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	class?: string;
	aspect?: string;
	priority?: boolean;
}

const { src, alt, class: className = '', aspect = 'aspect-[4/5]', priority = false } = Astro.props;
---

<div class={`model-card ${className}`}>
	<div class={`model-card__inner relative overflow-hidden rounded-sm bg-paper-2 ${aspect}`}>
		<Image
			src={src}
			alt={alt}
			class="h-full w-full object-cover"
			widths={[400, 800, 1200]}
			sizes="(max-width: 768px) 100vw, 50vw"
			loading={priority ? 'eager' : 'lazy'}
		/>
		<div class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-ink/10"></div>
	</div>
</div>
