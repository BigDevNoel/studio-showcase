---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import swatchesPhoto from '../assets/images/contact-swatches-tray.jpg';

const address = '3204 Norfolk Street, Suite 2, Richmond, VA 23230';
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
---

<Layout
	title="Contact"
	description="Request a consultation with Plumbline Studio. Visit us at 3204 Norfolk Street in Scott's Addition, Richmond, VA, or send project details through our intake form."
>
	<section class="mx-auto max-w-6xl px-6 pb-10 pt-10 sm:pt-16">
		<p class="ref-tag inline-block text-navy">No. 00 · Contact</p>
		<h1 class="mt-5 max-w-2xl font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-5xl">
			Tell us about your home.
		</h1>
		<p class="mt-6 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg">
			A first walkthrough is complimentary and confidential, and usually runs an hour. Bring
			photos of the rooms if you have them — they help more than a description does.
		</p>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-20">
		<div class="grid gap-10 lg:grid-cols-[1fr_1.15fr]">
			<div class="veil-lift space-y-10">
				<div class="veil-content space-y-10">
					<div>
						<p class="font-mono text-xs uppercase tracking-[0.15em] text-ink-faint">Studio</p>
						<p class="mt-2 text-lg text-ink">3204 Norfolk Street, Suite 2</p>
						<p class="text-lg text-ink">Scott&rsquo;s Addition, Richmond, VA 23230</p>
					</div>

					<div>
						<p class="font-mono text-xs uppercase tracking-[0.15em] text-ink-faint">Reach us</p>
						<p class="mt-2">
							<a href="tel:+18045550176" class="text-lg text-ink hover:text-navy">(804) 555-0176</a>
						</p>
						<p>
							<a href="mailto:studio@plumblinestudio.com" class="text-lg text-ink hover:text-navy"
								>studio@plumblinestudio.com</a
							>
						</p>
					</div>

					<div>
						<p class="font-mono text-xs uppercase tracking-[0.15em] text-ink-faint">By Appointment</p>
						<dl class="mt-2 space-y-1 font-mono text-sm text-ink-soft">
							<div class="flex justify-between gap-6"><dt>Mon&ndash;Fri</dt><dd>9:00a &ndash; 5:00p</dd></div>
							<div class="flex justify-between gap-6"><dt>Sat&ndash;Sun</dt><dd>Reserved for install days</dd></div>
						</dl>
						<p class="mt-3 text-sm text-ink-faint">Studio visits and material library tours are by appointment only.</p>
					</div>

					<div class="overflow-hidden rounded-sm border border-ink/10">
						<iframe
							title="Map to Plumbline Studio"
							src={mapSrc}
							class="h-56 w-full grayscale"
							style="border: 0;"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
						></iframe>
					</div>

					<div class="aspect-[16/10] overflow-hidden rounded-sm">
						<Image
							src={swatchesPhoto}
							alt="Fabric and material swatches arranged on a tray in the studio"
							class="h-full w-full object-cover"
							widths={[500, 900]}
							sizes="(max-width: 1024px) 100vw, 45vw"
						/>
					</div>
				</div>
			</div>

			<div class="rise-in bg-weave rounded-sm border border-ink/10 bg-vellum p-7 sm:p-9">
				<p class="ref-tag inline-block text-navy">No. 01 · Intake</p>
				<h2 class="mt-3 font-display text-2xl font-semibold text-ink">Request a consultation</h2>
				<form id="contact-form" class="mt-6 space-y-5">
					<div class="grid gap-5 sm:grid-cols-2">
						<div>
							<label for="name" class="block font-mono text-xs uppercase tracking-[0.15em] text-ink-faint">Name</label>
							<input
								id="name"
								name="name"
								type="text"
								required
								class="mt-2 w-full rounded-sm border border-ink/20 bg-paper px-4 py-2.5 text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
								placeholder="Your name"
							/>
						</div>
						<div>
							<label for="email" class="block font-mono text-xs uppercase tracking-[0.15em] text-ink-faint">Email</label>
							<input
								id="email"
								name="email"
								type="email"
								required
								class="mt-2 w-full rounded-sm border border-ink/20 bg-paper px-4 py-2.5 text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
								placeholder="you@email.com"
							/>
						</div>
					</div>

					<div>
						<label for="address" class="block font-mono text-xs uppercase tracking-[0.15em] text-ink-faint"
							>Home address or neighborhood</label
						>
						<input
							id="address"
							name="address"
							type="text"
							class="mt-2 w-full rounded-sm border border-ink/20 bg-paper px-4 py-2.5 text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
							placeholder="e.g. Windsor Farms, or a full address"
						/>
					</div>

					<div class="grid gap-5 sm:grid-cols-2">
						<div>
							<label for="project-type" class="block font-mono text-xs uppercase tracking-[0.15em] text-ink-faint"
								>Project type</label
							>
							<select
								id="project-type"
								name="project-type"
								class="mt-2 w-full rounded-sm border border-ink/20 bg-paper px-4 py-2.5 text-ink focus:border-navy focus:outline-none"
							>
								<option>Full-home design</option>
								<option>Single-room design</option>
								<option>New-build interiors</option>
								<option>Art &amp; antiques curation</option>
								<option>Not sure yet</option>
							</select>
						</div>
						<div>
							<label for="budget" class="block font-mono text-xs uppercase tracking-[0.15em] text-ink-faint"
								>Estimated furnishings budget</label
							>
							<select
								id="budget"
								name="budget"
								class="mt-2 w-full rounded-sm border border-ink/20 bg-paper px-4 py-2.5 text-ink focus:border-navy focus:outline-none"
							>
								<option>$150,000 &ndash; $300,000</option>
								<option>$300,000 &ndash; $750,000</option>
								<option>$750,000 &ndash; $1,500,000</option>
								<option>$1,500,000+</option>
							</select>
						</div>
					</div>

					<div>
						<label for="message" class="block font-mono text-xs uppercase tracking-[0.15em] text-ink-faint">Tell us about it</label>
						<textarea
							id="message"
							name="message"
							rows="4"
							class="mt-2 w-full rounded-sm border border-ink/20 bg-paper px-4 py-2.5 text-ink placeholder:text-ink-faint focus:border-navy focus:outline-none"
							placeholder="What's the home, and what isn't working about it right now?"
						></textarea>
					</div>

					<button
						type="submit"
						class="w-full rounded-sm bg-navy px-6 py-3 font-mono text-xs uppercase tracking-[0.15em] text-vellum transition-colors hover:bg-ink"
					>
						Send to the Studio
					</button>
					<p id="form-status" class="hidden font-mono text-xs uppercase tracking-[0.15em] text-navy" role="status"></p>
				</form>
			</div>
		</div>
	</section>
</Layout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const status = document.getElementById('form-status');
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (status) {
			status.textContent = 'Received — a principal will reply within two business days.';
			status.classList.remove('hidden');
		}
		form.reset();
	});
</script>
