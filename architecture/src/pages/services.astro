---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import fabricSwatches from '../assets/images/material-fabric-swatches-flatlay.jpg';
import brassFaucet from '../assets/images/material-brass-faucet-marble.jpg';

const services = [
	{
		sheet: 'No. 01',
		title: 'Full-Service Interior Design',
		copy: 'Whole-home design from space planning through final styling — furniture, fabric, art, and every finish selected and installed by the studio.',
		fee: 'Design fee 25% of the furnishings and finishes budget. Typical projects run $300,000–$1,500,000 in furnishings, art, and finishes.',
		note: 'Includes a dedicated procurement lead tracking every order through delivery and install.',
	},
	{
		sheet: 'No. 02',
		title: 'Single-Room Design',
		copy: 'A primary suite, a library, a formal dining room — one room done properly, with the same material rigor as a whole-home project.',
		fee: 'Flat fee from $18,500 per room, scoped after an in-home walkthrough.',
		note: null,
	},
	{
		sheet: 'No. 03',
		title: 'Art & Antiques Curation',
		copy: 'Sourcing and placement for a collection, a single significant piece, or the antiques that give a new build a sense of history.',
		fee: 'Advisory work billed at $250/hr, or a flat sourcing package from $12,000.',
		note: 'Led personally by Dana, who maintains relationships with dealers and auction houses across the East Coast.',
	},
	{
		sheet: 'No. 04',
		title: 'New-Build & Renovation Interiors',
		copy: 'Interiors designed alongside your architect or builder from the start, so finishes and furniture plans inform construction decisions rather than following them.',
		fee: 'Design fee 18% of the combined construction and furnishings budget.',
		note: null,
	},
	{
		sheet: 'No. 05',
		title: 'Bespoke Furniture & Millwork',
		copy: 'Pieces designed and built in our own workshop — a dining table, a primary-suite headboard, a library ladder — when nothing on the market is right.',
		fee: 'From $6,500 per piece, depending on material and joinery.',
		note: 'Led by Marcus, who still cuts the first joint on every piece himself.',
	},
];
---

<Layout
	title="Services"
	description="Full-service interior design, single-room design, art and antiques curation, new-build interiors, and bespoke furniture from Plumbline Studio in Richmond, VA."
>
	<section class="mx-auto max-w-6xl px-6 pb-16 pt-10 sm:pt-16">
		<p class="ref-tag inline-block text-navy">No. 00 · Services</p>
		<h1 class="mt-5 max-w-2xl font-display text-4xl font-semibold leading-[1.05] tracking-tight text-ink sm:text-5xl">
			Five ways to work with us.
		</h1>
		<p class="mt-6 max-w-xl text-base leading-relaxed text-ink-soft sm:text-lg">
			We take on twelve residences a year, most with furnishings and finishes budgets of
			$300,000 and up. Fees below are typical ranges from recent work — every proposal is
			scoped after a walkthrough of your home, not quoted blind.
		</p>
	</section>

	<section class="border-t border-ink/10 bg-paper-2">
		<div class="mx-auto max-w-6xl divide-y divide-ink/10 px-6">
			{
				services.map((s) => (
					<div class="rise-in grid gap-6 py-12 md:grid-cols-[120px_1fr_1fr] md:gap-10">
						<p class="ref-tag h-fit text-ink-faint">{s.sheet}</p>
						<div>
							<h2 class="font-display text-2xl font-semibold text-ink">{s.title}</h2>
							<p class="mt-3 leading-relaxed text-ink-soft">{s.copy}</p>
						</div>
						<div class="border-t border-ink/10 pt-4 md:border-t-0 md:border-l md:pl-10 md:pt-0">
							<p class="font-mono text-xs uppercase tracking-[0.15em] text-navy">Fee</p>
							<p class="mt-2 text-sm leading-relaxed text-ink">{s.fee}</p>
							{s.note && <p class="mt-2 text-sm leading-relaxed text-ink-faint">{s.note}</p>}
						</div>
					</div>
				))
			}
		</div>
	</section>

	<!-- MATERIAL LIBRARY -->
	<section class="border-t border-ink/10">
		<div class="mx-auto max-w-6xl px-6 py-20">
			<p class="font-mono text-xs uppercase tracking-[0.2em] text-navy">The Material Library</p>
			<h2 class="mt-4 max-w-xl font-display text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
				Fee percentages, not hourly guessing games.
			</h2>
			<p class="mt-4 max-w-2xl leading-relaxed text-ink-soft">
				Most designers bill hourly and let a project&rsquo;s cost drift. We quote a percentage
				of the furnishings and finishes budget up front, fixed at Concept, so you know what
				design will cost before the first fabric order goes in.
			</p>

			<div class="mt-12 grid gap-6 sm:grid-cols-2">
				<div class="veil-lift aspect-[4/3] overflow-hidden rounded-sm">
					<div class="veil-content h-full w-full">
						<Image
							src={fabricSwatches}
							alt="A flat lay of fabric and material samples used for selecting finishes"
							class="h-full w-full object-cover"
							widths={[500, 900]}
							sizes="(max-width: 640px) 100vw, 50vw"
						/>
					</div>
				</div>
				<div class="veil-lift aspect-[4/3] overflow-hidden rounded-sm">
					<div class="veil-content h-full w-full">
						<Image
							src={brassFaucet}
							alt="A brass faucet fixture against a marble wall, an example of the hardware and stone pairings the studio specifies"
							class="h-full w-full object-cover"
							widths={[500, 900]}
							sizes="(max-width: 640px) 100vw, 50vw"
						/>
					</div>
				</div>
			</div>
			<p class="mt-4 text-sm leading-relaxed text-ink-faint">
				A working sample of the material library at Rennie Street — every hardware finish and
				textile gets paired and reviewed in the studio before it&rsquo;s specified.
			</p>
		</div>
	</section>

	<section class="border-t border-ink/10 bg-navy text-vellum">
		<div class="mx-auto flex max-w-6xl flex-col items-start gap-6 px-6 py-20 sm:flex-row sm:items-center sm:justify-between">
			<div>
				<h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
					Not sure which service fits?
				</h2>
				<p class="mt-3 max-w-md text-vellum/80">
					Tell us about the home — we&rsquo;ll tell you honestly where to start.
				</p>
			</div>
			<a
				href="/contact"
				class="whitespace-nowrap rounded-sm bg-vellum px-6 py-3 font-mono text-xs uppercase tracking-[0.15em] text-navy transition-colors hover:bg-brass hover:text-ink"
			>
				Request a Consultation
			</a>
		</div>
	</section>
</Layout>
