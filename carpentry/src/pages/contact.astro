---
import Layout from '../layouts/Layout.astro';

const address = '212 Broad Brook Rd, Waitsfield, VT 05673';
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
---

<Layout
	title="Contact"
	description="Reach Broad Brook Timberworks at 212 Broad Brook Rd, Waitsfield, Vermont. Site visits and shop tours by appointment."
>
	<section class="mx-auto max-w-6xl px-6 pt-16 pb-10 sm:pt-24">
		<p class="font-mono text-xs uppercase tracking-[0.3em] text-verdigris-deep">Contact</p>
		<h1 class="mt-3 max-w-2xl font-display text-4xl font-semibold leading-[0.98] tracking-tight text-oak-ink sm:text-6xl">
			Tell us what you're building.
		</h1>
		<p class="mt-6 max-w-xl text-base leading-relaxed text-oak-ink-soft sm:text-lg">
			Every project starts with a site visit — $150, waived if you move forward with a frame.
			Shop tours run by appointment.
		</p>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-10 pb-20">
		<div class="grid gap-10 lg:grid-cols-[1fr_1.1fr]">
			<div class="bench-reveal space-y-10">
				<div>
					<p class="font-mono text-xs uppercase tracking-[0.15em] text-oak-ink-faint">Shop address</p>
					<p class="mt-2 text-lg text-oak-ink">212 Broad Brook Rd</p>
					<p class="text-lg text-oak-ink">Waitsfield, VT 05673</p>
				</div>

				<div>
					<p class="font-mono text-xs uppercase tracking-[0.15em] text-oak-ink-faint">Reach us</p>
					<p class="mt-2">
						<a href="tel:+18025550119" class="text-lg text-oak-ink hover:text-verdigris-deep">(802) 555-0119</a>
					</p>
					<p>
						<a href="mailto:hello@broadbrooktimberworks.com" class="text-lg text-oak-ink hover:text-verdigris-deep">hello@broadbrooktimberworks.com</a>
					</p>
				</div>

				<div>
					<p class="font-mono text-xs uppercase tracking-[0.15em] text-oak-ink-faint">Shop hours</p>
					<dl class="mt-2 space-y-1 font-mono text-sm text-oak-ink-soft">
						<div class="flex justify-between gap-6"><dt>Mon&ndash;Fri</dt><dd>7:00a &ndash; 4:00p</dd></div>
						<div class="flex justify-between gap-6"><dt>Sat</dt><dd>By appointment</dd></div>
						<div class="flex justify-between gap-6"><dt>Sun</dt><dd>Closed</dd></div>
					</dl>
					<p class="mt-3 text-sm text-oak-ink-soft">Shop bookings typically run 4&ndash;9 months out — reach out early for spring raisings.</p>
				</div>

				<div class="timber-card overflow-hidden border border-oak-ink-faint/30">
					<iframe
						title="Map to Broad Brook Timberworks"
						src={mapSrc}
						class="h-64 w-full"
						style="border: 0;"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
			</div>

			<div class="bench-reveal rounded-sm border border-oak-ink-faint/30 bg-shaving p-7 sm:p-8" style="transition-delay: 100ms">
				<p class="font-mono text-xs uppercase tracking-[0.3em] text-verdigris-deep">Shop intake</p>
				<h2 class="mt-2 font-display text-2xl font-semibold tracking-tight text-oak-ink">Request a quote or ask a question</h2>
				<form id="contact-form" class="mt-6 space-y-5">
					<div>
						<label for="name" class="block font-mono text-xs uppercase tracking-[0.15em] text-oak-ink-faint">Name</label>
						<input id="name" name="name" type="text" required class="mt-2 w-full rounded-sm border border-oak-ink-faint/40 bg-sawdust px-4 py-2.5 text-oak-ink placeholder:text-oak-ink-faint focus:border-verdigris focus:outline-none" placeholder="Your name" />
					</div>
					<div>
						<label for="email" class="block font-mono text-xs uppercase tracking-[0.15em] text-oak-ink-faint">Email</label>
						<input id="email" name="email" type="email" required class="mt-2 w-full rounded-sm border border-oak-ink-faint/40 bg-sawdust px-4 py-2.5 text-oak-ink placeholder:text-oak-ink-faint focus:border-verdigris focus:outline-none" placeholder="you@email.com" />
					</div>
					<div>
						<label for="project" class="block font-mono text-xs uppercase tracking-[0.15em] text-oak-ink-faint">Project type</label>
						<select id="project" name="project" class="mt-2 w-full rounded-sm border border-oak-ink-faint/40 bg-sawdust px-4 py-2.5 text-oak-ink focus:border-verdigris focus:outline-none">
							<option>Timber frame home</option>
							<option>Addition or porch</option>
							<option>Barn or pavilion</option>
							<option>Historic barn restoration</option>
							<option>Custom joinery piece</option>
							<option>Not sure yet</option>
						</select>
					</div>
					<div>
						<label for="message" class="block font-mono text-xs uppercase tracking-[0.15em] text-oak-ink-faint">Message</label>
						<textarea id="message" name="message" rows="4" class="mt-2 w-full rounded-sm border border-oak-ink-faint/40 bg-sawdust px-4 py-2.5 text-oak-ink placeholder:text-oak-ink-faint focus:border-verdigris focus:outline-none" placeholder="Site location, rough timeline, anything you already know you want."></textarea>
					</div>
					<button type="submit" class="plane-cta w-full rounded-sm bg-verdigris px-6 py-3 font-mono text-xs uppercase tracking-[0.15em] text-shaving transition-colors hover:bg-verdigris-deep">
						Send
					</button>
					<p id="form-status" class="hidden font-mono text-xs uppercase tracking-[0.15em] text-verdigris-deep" role="status"></p>
				</form>
			</div>
		</div>
	</section>
</Layout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const status = document.getElementById('form-status');
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (status) {
			status.textContent = 'Sent — we\'ll follow up within two business days.';
			status.classList.remove('hidden');
		}
		form.reset();
	});
</script>
