---
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/services', label: 'Services' },
	{ href: '/gallery', label: 'Gallery' },
	{ href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-oak-ink-faint/30 bg-sawdust/90 backdrop-blur">
	<div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<a href="/" class="group flex items-baseline gap-2">
			<span class="font-display text-2xl font-semibold tracking-tight text-oak-ink">
				Broad Brook
			</span>
			<span class="hidden font-mono text-[11px] uppercase tracking-[0.2em] text-oak-ink-faint sm:inline">
				Timberworks
			</span>
		</a>

		<nav aria-label="Primary" class="hidden md:block">
			<ul class="flex items-center gap-8">
				{
					links.map((link) => {
						const active = path === link.href;
						return (
							<li>
								<a
									href={link.href}
									class:list={[
										'font-mono text-xs uppercase tracking-[0.15em] transition-colors',
										active ? 'text-verdigris-deep' : 'text-oak-ink-soft hover:text-verdigris-deep',
									]}
									aria-current={active ? 'page' : undefined}
								>
									{link.label}
								</a>
							</li>
						);
					})
				}
			</ul>
		</nav>

		<a
			href="/contact"
			class="plane-cta hidden rounded-sm border border-verdigris px-4 py-2 font-mono text-xs uppercase tracking-[0.15em] text-verdigris-deep transition-colors hover:bg-verdigris hover:text-shaving md:inline-block"
		>
			Request a Quote
		</a>

		<button
			id="menu-toggle"
			class="text-oak-ink md:hidden"
			aria-expanded="false"
			aria-controls="mobile-menu"
			aria-label="Toggle menu"
		>
			<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M3 6h18M3 12h18M3 18h18" />
			</svg>
		</button>
	</div>

	<nav id="mobile-menu" aria-label="Mobile" class="hidden border-t border-oak-ink-faint/30 md:hidden">
		<ul class="flex flex-col px-6 py-4">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							class="block py-3 font-mono text-sm uppercase tracking-[0.15em] text-oak-ink-soft hover:text-verdigris-deep"
						>
							{link.label}
						</a>
					</li>
				))
			}
			<li class="pt-2">
				<a
					href="/contact"
					class="inline-block rounded-sm border border-verdigris px-4 py-2 font-mono text-xs uppercase tracking-[0.15em] text-verdigris-deep"
				>
					Request a Quote
				</a>
			</li>
		</ul>
	</nav>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');
	toggle?.addEventListener('click', () => {
		const isOpen = menu?.classList.toggle('hidden') === false;
		toggle.setAttribute('aria-expanded', String(isOpen));
	});
</script>
