---
// Signature hero: a true mortise-and-tenon joint assembling in 3D — the
// literal mechanism that holds a hand-cut timber frame together with no
// metal fasteners. A horizontal beam's tenon slides into the mortise
// pocket cut in the post, then a wooden peg drives down to drawbore the
// joint tight. Not decorative: this is the actual product.
---

<section class="relative overflow-hidden bg-sawdust pb-24 pt-16 sm:pt-24">
	<div class="relative mx-auto max-w-6xl px-6">
		<div class="grid items-center gap-16 lg:grid-cols-[1.05fr_0.95fr]">
			<div>
				<p class="font-mono text-xs uppercase tracking-[0.3em] text-verdigris-deep">
					Waitsfield, Vermont &middot; Mad River Valley
				</p>
				<h1 class="mt-4 font-display text-5xl font-semibold leading-[0.98] tracking-tight text-oak-ink sm:text-6xl lg:text-7xl">
					Frames held by
					<br />
					wood, not
					<br />
					<span class="text-verdigris-deep">hardware.</span>
				</h1>
				<p class="mt-6 max-w-md text-lg leading-relaxed text-oak-ink-soft">
					Broad Brook Timberworks hand-cuts post-and-beam frames the way they've been cut for
					three hundred years &mdash; mortise, tenon, and a driven peg. No plates, no lag bolts,
					no glue.
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					<a
						href="/contact"
						class="plane-cta rounded-sm bg-verdigris px-6 py-3 font-mono text-sm uppercase tracking-[0.15em] text-shaving transition-transform hover:-translate-y-0.5"
					>
						Request a quote
					</a>
					<a
						href="/services"
						class="rounded-sm border border-oak-ink-faint px-6 py-3 font-mono text-sm uppercase tracking-[0.15em] text-oak-ink transition-colors hover:border-verdigris-deep hover:text-verdigris-deep"
					>
						See our work &amp; pricing
					</a>
				</div>
			</div>

			<!-- the joint rig -->
			<div class="relative mx-auto h-72 w-full max-w-md [perspective:1500px] sm:h-80">
				<div
					class="joint-rig relative h-full w-full [transform-style:preserve-3d]"
					style="transform: rotateX(16deg) rotateY(-16deg);"
				>
					<!-- post: fixed vertical member -->
					<div
						class="absolute left-[54%] top-2 h-full w-16 rounded-[2px] bg-[#c9b183] shadow-[0_20px_50px_-20px_rgba(43,33,22,0.5)] ring-1 ring-oak-ink-faint/30"
						style="transform: translateZ(0px);"
					>
						<div class="absolute inset-x-1 top-2 h-2 rounded-sm bg-oak-ink-faint/25"></div>
						<div class="absolute inset-x-1 bottom-2 h-2 rounded-sm bg-oak-ink-faint/25"></div>
						<!-- mortise pocket, carved into the post's face -->
						<div
							class="absolute left-[-2px] top-[42%] h-10 w-6 rounded-[1px] bg-[#7a6647] shadow-[inset_3px_0_6px_rgba(0,0,0,0.45)]"
						>
						</div>
					</div>

					<!-- beam: slides in, tenon-piece -->
					<div
						class="tenon-piece absolute left-0 top-[45%] h-14 w-[58%] -translate-y-1/2 rounded-[2px] bg-[#d8be8c] shadow-[0_16px_36px_-16px_rgba(43,33,22,0.5)] ring-1 ring-oak-ink-faint/30"
						style="transform: translateZ(8px);"
					>
						<div class="absolute inset-x-2 top-1.5 h-1 rounded-full bg-shaving/40"></div>
						<!-- tenon tongue -->
						<div class="absolute -right-4 top-1/2 h-8 w-6 -translate-y-1/2 rounded-[1px] bg-[#e6cd9c] ring-1 ring-oak-ink-faint/20"></div>
					</div>

					<!-- peg: drives down through the completed joint -->
					<div
						class="peg-piece absolute left-[58%] top-0 h-24 w-3 rounded-full bg-verdigris-deep shadow-[0_10px_18px_-6px_rgba(39,83,73,0.6)]"
						style="transform: translateZ(16px);"
					>
					</div>
				</div>
				<p class="mt-8 text-center font-mono text-[11px] uppercase tracking-[0.25em] text-oak-ink-faint">
					Mortise &middot; Tenon &middot; Drawbored Peg
				</p>
			</div>
		</div>
	</div>
</section>
