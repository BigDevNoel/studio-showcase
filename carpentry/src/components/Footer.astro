---
const year = new Date().getFullYear();
---

<footer class="border-t border-oak-ink-faint/30 bg-sawdust-2">
	<div class="mx-auto max-w-6xl px-6 py-14">
		<div class="grid gap-10 sm:grid-cols-3">
			<div>
				<p class="font-display text-xl font-semibold tracking-tight text-oak-ink">Broad Brook Timberworks</p>
				<p class="mt-3 max-w-xs text-sm text-oak-ink-soft">
					Hand-cut post-and-beam timber frames and barn restoration in the Mad River Valley, Vermont.
				</p>
			</div>

			<div class="font-mono text-sm text-oak-ink-soft">
				<p class="mb-2 uppercase tracking-[0.15em] text-oak-ink-faint">Shop</p>
				<p>212 Broad Brook Rd</p>
				<p>Waitsfield, VT 05673</p>
				<p class="mt-3">
					<a href="tel:+18025550119" class="hover:text-verdigris-deep">(802) 555-0119</a>
				</p>
				<p><a href="mailto:hello@broadbrooktimberworks.com" class="hover:text-verdigris-deep">hello@broadbrooktimberworks.com</a></p>
			</div>

			<div class="font-mono text-sm text-oak-ink-soft">
				<p class="mb-2 uppercase tracking-[0.15em] text-oak-ink-faint">Shop hours</p>
				<p>Mon&ndash;Fri &nbsp; 7a&ndash;4p</p>
				<p>Sat &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; By appointment</p>
				<p>Sun &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Closed</p>
				<p class="mt-3">
					<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="hover:text-verdigris-deep"
						>@broadbrooktimberworks</a
					>
				</p>
			</div>
		</div>

		<div class="story-pole my-8"></div>

		<div class="flex flex-col gap-3 text-xs text-oak-ink-faint sm:flex-row sm:items-center sm:justify-between">
			<p>&copy; {year} Broad Brook Timberworks</p>
			<p>Concept site by Noel Ngerem &middot; not a real business</p>
		</div>
	</div>
</footer>
