---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	name: string;
	description: string;
	href: string;
	desktopImg: ImageMetadata;
	mobileImg: ImageMetadata;
}

const { name, description, href, desktopImg, mobileImg } = Astro.props;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class="project-card tilt-card group relative block overflow-hidden rounded-md border border-line/70 bg-cream-light"
	style="transform: perspective(1000px) rotateX(0deg) rotateY(0deg);"
>
	<span class="glare"></span>
	<div class="desktop-shot relative aspect-[19/10] overflow-hidden bg-ink-3">
		<Image
			src={desktopImg}
			alt={`Desktop homepage screenshot of ${name}`}
			class="h-full w-full object-cover object-top"
			widths={[400, 800]}
			sizes="(max-width: 640px) 90vw, (max-width: 1024px) 45vw, 30vw"
			loading="lazy"
		/>
		<div class="mobile-shot absolute bottom-3 right-3 aspect-[9/17] w-[22%] overflow-hidden rounded-[6px] border-2 border-cream-light shadow-[0_10px_24px_-8px_rgba(8,9,13,0.5)]">
			<Image
				src={mobileImg}
				alt={`Mobile homepage screenshot of ${name}`}
				class="h-full w-full object-cover object-top"
				widths={[120, 240]}
				sizes="120px"
				loading="lazy"
			/>
		</div>
	</div>
	<div class="card-body p-6">
		<div class="flex items-center justify-between gap-3">
			<h3 class="font-display text-lg font-bold tracking-tight text-ink">{name}</h3>
			<span class="shrink-0 font-body text-sm font-semibold text-accent-dim transition-transform group-hover:translate-x-1">
				View live site &rarr;
			</span>
		</div>
		<p class="mt-2 text-sm leading-relaxed text-ink/70">{description}</p>
	</div>
</a>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const canHover = window.matchMedia('(pointer: fine)').matches;

	if (!reduceMotion && canHover) {
		document.querySelectorAll<HTMLElement>('.tilt-card').forEach((card) => {
			card.addEventListener('mousemove', (e) => {
				const rect = card.getBoundingClientRect();
				const px = (e.clientX - rect.left) / rect.width - 0.5;
				const py = (e.clientY - rect.top) / rect.height - 0.5;
				card.style.transform = `perspective(1000px) rotateX(${(py * -10).toFixed(2)}deg) rotateY(${(px * 12).toFixed(2)}deg)`;
			});
			card.addEventListener('mouseleave', () => {
				card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
			});
		});
	}
</script>
