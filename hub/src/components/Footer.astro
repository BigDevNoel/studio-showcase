---
const year = new Date().getFullYear();
---

<footer class="bg-ink-3 text-cream-light">
	<div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-14 sm:flex-row sm:items-start sm:justify-between">
		<div>
			<p class="font-display text-lg font-bold tracking-tight">
				BigDev<span class="text-accent-bright">Noel</span>
			</p>
			<p class="mt-2 max-w-xs text-sm text-cream-light/60">
				Software engineer building AI software, SaaS, apps, e-commerce, and websites. No templates, no off-the-shelf answers.
			</p>
		</div>

		<div class="flex gap-12 text-sm">
			<div class="flex flex-col gap-2">
				<span class="font-body font-semibold text-cream-light/90">Site</span>
				<a href="#work" class="text-cream-light/60 transition-colors hover:text-accent-bright">Work</a>
				<a href="#contact" class="text-cream-light/60 transition-colors hover:text-accent-bright">Contact</a>
			</div>
			<div class="flex flex-col gap-2">
				<span class="font-body font-semibold text-cream-light/90">Elsewhere</span>
				<a href="https://github.com" class="text-cream-light/60 transition-colors hover:text-accent-bright">GitHub</a>
				<a href="https://linkedin.com" class="text-cream-light/60 transition-colors hover:text-accent-bright">LinkedIn</a>
			</div>
		</div>
	</div>
	<div class="border-t border-cream-light/10 px-6 py-5 text-center text-xs text-cream-light/40">
		&copy; {year} BigDevNoel. All rights reserved.
	</div>
</footer>
