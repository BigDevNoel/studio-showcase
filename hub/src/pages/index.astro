---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { Image } from 'astro:assets';

import carpentryDesktop from '../assets/screenshots/carpentry-desktop.png';
import carpentryMobile from '../assets/screenshots/carpentry-mobile.jpg';
import salonDesktop from '../assets/screenshots/salon-desktop.png';
import salonMobile from '../assets/screenshots/salon-mobile.jpg';
import gymDesktop from '../assets/screenshots/gym-desktop.png';
import gymMobile from '../assets/screenshots/gym-mobile.jpg';
import architectureDesktop from '../assets/screenshots/interior-design-desktop.png';
import architectureMobile from '../assets/screenshots/interior-design-mobile.jpg';
import clinicDesktop from '../assets/screenshots/clinic-desktop.png';
import clinicMobile from '../assets/screenshots/clinic-mobile.jpg';

const email = 'emmanuelngerem05@gmail.com';
const whatsapp = '2349138331909';
const whatsappDisplay = '+234 913 833 1909';

const projects = [
	{
		name: 'Broad Brook Timberworks',
		description:
			'A timber-frame restoration outfit hand-cutting joinery in an 1890s Vermont dairy barn. Earthy oak-and-ink palette, hand-plane photography, a story-pole scroll divider.',
		href: 'https://bigdevnoel-carpentry.vercel.app/',
		desktopImg: carpentryDesktop,
		mobileImg: carpentryMobile,
	},
	{
		name: 'Salt & Iron',
		description:
			'A unisex cut, color, and barbering studio inside a converted 1948 metal shop in Asheville. Graphite and steel warmed by a hot temper-gold accent.',
		href: 'https://bigdevnoel-salon.vercel.app/',
		desktopImg: salonDesktop,
		mobileImg: salonMobile,
	},
	{
		name: 'The Foundry',
		description:
			'A barbell gym for powerlifters in a 1911 Pittsburgh iron foundry. Near-black and high-voltage green, viewfinder-style hover reveals.',
		href: 'https://bigdevnoel-gym.vercel.app/',
		desktopImg: gymDesktop,
		mobileImg: gymMobile,
	},
	{
		name: 'Plumbline Studio',
		description:
			'A boutique interior design practice out of a Richmond tobacco warehouse. Navy, vellum, and brass-light behind a slow Ken Burns hero.',
		href: 'https://bigdevnoel-interior-design.vercel.app/',
		desktopImg: architectureDesktop,
		mobileImg: architectureMobile,
	},
	{
		name: 'Cherry Creek Dermatology',
		description:
			'A Denver dermatology practice built around high-altitude UV risk. Porcelain and clinical blue, editorial and precise.',
		href: 'https://bigdevnoel-clinic.vercel.app/',
		desktopImg: clinicDesktop,
		mobileImg: clinicMobile,
	},
];

const heroFloats = [
	{ img: gymDesktop, float: 'a', style: 'top:6%; left:1%; width:15rem; height:9.5rem;' },
	{ img: architectureDesktop, float: 'b', style: 'top:2%; right:2%; width:13rem; height:8.5rem;' },
	{ img: clinicDesktop, float: 'c', style: 'bottom:10%; left:8%; width:12rem; height:8rem;' },
	{ img: salonDesktop, float: 'd', style: 'bottom:4%; right:9%; width:14rem; height:9rem;' },
];
---

<Layout
	title="BigDevNoel | Software engineer building AI software, SaaS, apps, e-commerce & websites"
	description="I'm a software engineer who builds distinctive, well-crafted software: AI-powered software, SaaS platforms, web and mobile apps, e-commerce, and marketing sites. No templates, no off-the-shelf answers. See five recent web projects."
>
	<Nav />

	<main id="top">
		<!-- HERO -->
		<section class="hero-stage mx-auto max-w-6xl overflow-hidden px-6 pb-16 pt-16 text-center sm:pb-24 sm:pt-24">
			<div class="hero-rig z-0 hidden sm:block" aria-hidden="true">
				{heroFloats.map((f) => (
					<div class="hero-float" data-float={f.float} style={f.style}>
						<Image src={f.img} alt="" class="h-full w-full object-cover object-top" widths={[300, 500]} sizes="240px" loading="eager" />
					</div>
				))}
			</div>

			<div class="relative z-10 mx-auto max-w-2xl bg-cream px-4 py-6 sm:px-10 sm:py-10">
				<p class="font-body text-xs font-semibold uppercase tracking-[0.25em] text-accent-dim">Software Engineer</p>
				<h1 class="mx-auto mt-4 max-w-3xl font-display text-4xl font-bold leading-[1.05] tracking-tight text-ink sm:text-6xl">
					<span class="sr-only">I build software that doesn't feel off-the-shelf.</span>
					<span class="typewriter-grid" aria-hidden="true">
						<span class="typewriter-sizer">I build software that doesn't feel off-the-shelf.</span>
						<span class="typewriter-visible"><span id="typewriter"></span><span class="typewriter-cursor"></span></span>
						<span class="dev-setup" id="dev-setup">
							<span class="dev-setup-stage">
								<span class="dev-setup-rig">
									<span class="ds-desk"></span>
									<span class="ds-tower"><span class="ds-led"></span></span>
									<span class="ds-mug"><span class="ds-mug-handle"></span></span>
									<span class="ds-laptop">
										<span class="ds-laptop-screen">
											<span class="ds-code-line" style="width:70%"></span>
											<span class="ds-code-line" style="width:45%"></span>
											<span class="ds-code-line" style="width:58%"></span>
											<span class="ds-code-line ds-code-line-caret" style="width:30%"><span class="ds-caret"></span></span>
										</span>
										<span class="ds-laptop-base"></span>
									</span>
								</span>
							</span>
						</span>
					</span>
				</h1>
				<p class="mx-auto mt-6 max-w-xl text-base leading-relaxed text-ink/70 sm:text-lg">
					AI software, SaaS platforms, web and mobile apps, e-commerce, marketing sites. Whatever the product is,
					it's built from the problem, not a starter template. Below are five recent web projects
					that show the approach in practice.
				</p>
				<div class="mt-8 flex flex-wrap items-center justify-center gap-4">
					<a
						href="#work"
						class="rounded-sm border-2 border-ink bg-ink px-6 py-3 font-body text-sm font-semibold text-cream-light transition-colors hover:border-accent-dim hover:bg-accent-dim"
					>
						See the work
					</a>
					<a
						href="#contact"
						class="rounded-sm border-2 border-ink px-6 py-3 font-body text-sm font-semibold text-ink transition-colors hover:border-accent-dim hover:text-accent-dim"
					>
						Get in touch
					</a>
				</div>
			</div>
		</section>

		<!-- WORK -->
		<section id="work" class="mx-auto max-w-6xl px-6 pb-20 sm:pb-28">
			<div class="depth-reveal mb-10 flex items-end justify-between gap-4">
				<h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">My Works</h2>
				<p class="hidden font-body text-sm text-ink/50 sm:block">Five sites, five distinct identities</p>
			</div>
			<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{projects.map((p, i) => (
					<div class="depth-reveal" style={`transition-delay: ${i * 80}ms`}>
						<ProjectCard {...p} />
					</div>
				))}
			</div>
		</section>

		<!-- CTA BAND -->
		<section class="cta-stage relative overflow-hidden bg-ink-3 py-20 text-center text-cream-light sm:py-28">
			<div class="cta-grid-floor" aria-hidden="true"></div>
			<div class="cta-glow" aria-hidden="true"></div>
			<div class="depth-reveal cta-tilt relative mx-auto max-w-2xl px-6">
				<h2 class="font-display text-2xl font-bold tracking-tight sm:text-4xl">Have a project in mind?</h2>
				<p class="mx-auto mt-4 max-w-md text-sm text-cream-light/70 sm:text-base">
					AI product, SaaS, app, storefront, or site. If it needs to feel considered instead of templated, let's talk.
				</p>
				<a
					href="#contact"
					class="cta-button mt-8 inline-block rounded-sm bg-accent-dim px-7 py-3 font-body text-sm font-semibold text-cream-light"
				>
					Start a conversation
				</a>
			</div>
		</section>

		<!-- CONTACT -->
		<section id="contact" class="mx-auto max-w-2xl px-6 py-20 text-center sm:py-28">
			<div class="depth-reveal">
				<h2 class="font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">Let's talk about your project</h2>
				<p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-ink/70 sm:text-base">
					Send a note directly. Tell me a bit about what you're building and I'll reply within a day.
				</p>
				<div class="mt-8 flex w-full flex-col items-center gap-4 rounded-md border border-line bg-cream-light px-6 py-6 sm:inline-flex sm:w-auto sm:px-12 sm:py-8">
					<a href={`mailto:${email}`} class="max-w-full break-all font-display text-base font-bold tracking-tight text-ink transition-colors hover:text-accent sm:break-normal sm:text-2xl">
						{email}
					</a>
					<a
						href={`mailto:${email}`}
						class="rounded-sm border-2 border-ink bg-ink px-6 py-3 font-body text-sm font-semibold text-cream-light transition-colors hover:border-accent-dim hover:bg-accent-dim"
					>
						Email me
					</a>
					<div class="h-px w-full bg-line"></div>
					<a
						href={`https://wa.me/${whatsapp}`}
						target="_blank"
						rel="noopener noreferrer"
						class="max-w-full break-all font-display text-base font-bold tracking-tight text-ink transition-colors hover:text-accent sm:break-normal sm:text-xl"
					>
						{whatsappDisplay}
					</a>
					<a
						href={`https://wa.me/${whatsapp}`}
						target="_blank"
						rel="noopener noreferrer"
						class="rounded-sm border-2 border-ink px-6 py-3 font-body text-sm font-semibold text-ink transition-colors hover:border-accent-dim hover:text-accent-dim"
					>
						Message on WhatsApp
					</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<script>
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	// hero headline typewriter — type, hold, untype, then a small illustrated
	// dev setup (desk, laptop, tower) fills the gap instead of blank space,
	// before looping back to the main line
	const typewriterEl = document.getElementById('typewriter');
	const devSetupEl = document.getElementById('dev-setup');
	if (typewriterEl) {
		const fullText = "I build software that doesn't feel off-the-shelf.";

		if (reduceMotion) {
			typewriterEl.textContent = fullText;
		} else {
			const typeSpeed = 90;
			const deleteSpeed = 45;
			const holdTime = 3000;
			const illustrationHold = 1800;
			const restPause = 350;
			let i = 0;
			let deleting = false;

			const showIllustration = () => {
				if (!devSetupEl) return;
				devSetupEl.classList.remove('is-active');
				void devSetupEl.offsetWidth;
				devSetupEl.classList.add('is-active');
			};
			const hideIllustration = () => {
				devSetupEl?.classList.remove('is-active');
			};

			const tick = () => {
				if (!deleting) {
					i++;
					typewriterEl.textContent = fullText.slice(0, i);
					if (i >= fullText.length) {
						setTimeout(() => {
							deleting = true;
							tick();
						}, holdTime);
						return;
					}
					setTimeout(tick, typeSpeed);
				} else {
					i--;
					typewriterEl.textContent = fullText.slice(0, i);
					if (i <= 0) {
						deleting = false;
						showIllustration();
						setTimeout(() => {
							hideIllustration();
							setTimeout(tick, restPause);
						}, illustrationHold);
						return;
					}
					setTimeout(tick, deleteSpeed);
				}
			};
			tick();
		}
	}

	// scroll-triggered 3D reveals
	const revealEls = document.querySelectorAll<HTMLElement>('.depth-reveal');
	if (reduceMotion) {
		revealEls.forEach((el) => el.classList.add('is-visible'));
	} else {
		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						observer.unobserve(entry.target);
					}
				});
			},
			{ threshold: 0.15, rootMargin: '0px 0px -60px 0px' }
		);
		revealEls.forEach((el) => observer.observe(el));
	}

	// hero floating rig: group tilt toward the cursor
	const heroStage = document.querySelector<HTMLElement>('.hero-stage');
	const heroRig = document.querySelector<HTMLElement>('.hero-rig');
	if (heroStage && heroRig && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
		heroStage.addEventListener('mousemove', (e) => {
			const rect = heroStage.getBoundingClientRect();
			const px = (e.clientX - rect.left) / rect.width - 0.5;
			const py = (e.clientY - rect.top) / rect.height - 0.5;
			heroRig.style.transform = `rotateX(${(py * -8).toFixed(2)}deg) rotateY(${(px * 10).toFixed(2)}deg)`;
		});
		heroStage.addEventListener('mouseleave', () => {
			heroRig.style.transform = 'rotateX(0deg) rotateY(0deg)';
		});
	}

	// CTA band: content tilts toward the cursor
	const ctaStage = document.querySelector<HTMLElement>('.cta-stage');
	const ctaTilt = document.querySelector<HTMLElement>('.cta-tilt');
	if (ctaStage && ctaTilt && !reduceMotion && window.matchMedia('(pointer: fine)').matches) {
		ctaStage.addEventListener('mousemove', (e) => {
			const rect = ctaStage.getBoundingClientRect();
			const px = (e.clientX - rect.left) / rect.width - 0.5;
			const py = (e.clientY - rect.top) / rect.height - 0.5;
			ctaTilt.style.transform = `perspective(1000px) rotateX(${(py * -6).toFixed(2)}deg) rotateY(${(px * 8).toFixed(2)}deg)`;
		});
		ctaStage.addEventListener('mouseleave', () => {
			ctaTilt.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg)';
		});
	}
</script>
