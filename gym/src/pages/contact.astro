---
import Layout from '../layouts/Layout.astro';

const address = '4417 Butler St, Pittsburgh, PA 15201';
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(address)}&output=embed`;
---

<Layout
	title="Contact"
	description="Visit The Foundry Barbell Club at 4417 Butler St, Lawrenceville, Pittsburgh. Tours run daily during staffed hours."
>
	<section class="mx-auto max-w-6xl px-6 pt-16 pb-10 sm:pt-24">
		<p class="font-mono text-xs uppercase tracking-[0.3em] text-green">Contact</p>
		<h1 class="mt-3 max-w-2xl font-display text-4xl uppercase leading-[0.95] tracking-tight text-chalk sm:text-6xl">
			Come see the floor.
		</h1>
		<p class="mt-6 max-w-xl text-base leading-relaxed text-chalk-dim sm:text-lg">
			Tours run daily during staffed hours, no appointment needed. Wear shoes you can squat in.
		</p>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-10 pb-20">
		<div class="grid gap-10 lg:grid-cols-[1fr_1.1fr]">
			<div class="flash-reveal space-y-10">
				<div>
					<p class="font-mono text-xs uppercase tracking-[0.15em] text-chalk-dim">Address</p>
					<p class="mt-2 text-lg text-chalk">4417 Butler St</p>
					<p class="text-lg text-chalk">Lawrenceville, Pittsburgh, PA 15201</p>
				</div>

				<div>
					<p class="font-mono text-xs uppercase tracking-[0.15em] text-chalk-dim">Reach us</p>
					<p class="mt-2">
						<a href="tel:+14125550147" class="text-lg text-chalk hover:text-green">(412) 555-0147</a>
					</p>
					<p>
						<a href="mailto:train@foundrybarbell.com" class="text-lg text-chalk hover:text-green">train@foundrybarbell.com</a>
					</p>
				</div>

				<div>
					<p class="font-mono text-xs uppercase tracking-[0.15em] text-chalk-dim">Staffed hours</p>
					<dl class="mt-2 space-y-1 font-mono text-sm text-chalk-dim">
						<div class="flex justify-between gap-6"><dt>Mon&ndash;Fri</dt><dd>6:00a &ndash; 8:00p</dd></div>
						<div class="flex justify-between gap-6"><dt>Sat&ndash;Sun</dt><dd>8:00a &ndash; 2:00p</dd></div>
					</dl>
					<p class="mt-3 text-sm text-chalk-dim">24/7 fob access for Open Gym members and above.</p>
				</div>

				<div class="viewfinder overflow-hidden rounded-md border border-steel/40">
					<iframe
						title="Map to The Foundry Barbell Club"
						src={mapSrc}
						class="h-64 w-full"
						style="border: 0;"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
					<span class="vf-corner"></span>
					<span class="vf-corner"></span>
					<span class="vf-corner"></span>
					<span class="vf-corner"></span>
				</div>
			</div>

			<div class="flash-reveal whiteboard rounded-md p-7 sm:p-8" style="transition-delay: 100ms">
				<p class="font-mono text-xs uppercase tracking-[0.3em] text-green-ink">Front desk intake</p>
				<h2 class="mt-2 font-display text-2xl uppercase tracking-tight text-void">Book a tour or ask a question</h2>
				<form id="contact-form" class="mt-6 space-y-5">
					<div>
						<label for="name" class="block font-mono text-xs uppercase tracking-[0.15em] text-void/60">Name</label>
						<input id="name" name="name" type="text" required class="mt-2 w-full rounded-sm border border-void/20 bg-chalk px-4 py-2.5 text-void placeholder:text-void/40 focus:border-green-ink focus:outline-none" placeholder="Your name" />
					</div>
					<div>
						<label for="email" class="block font-mono text-xs uppercase tracking-[0.15em] text-void/60">Email</label>
						<input id="email" name="email" type="email" required class="mt-2 w-full rounded-sm border border-void/20 bg-chalk px-4 py-2.5 text-void placeholder:text-void/40 focus:border-green-ink focus:outline-none" placeholder="you@email.com" />
					</div>
					<div>
						<label for="interest" class="block font-mono text-xs uppercase tracking-[0.15em] text-void/60">Interested in</label>
						<select id="interest" name="interest" class="mt-2 w-full rounded-sm border border-void/20 bg-chalk px-4 py-2.5 text-void focus:border-green-ink focus:outline-none">
							<option>A tour</option>
							<option>Open Gym membership</option>
							<option>Coached Strength Program</option>
							<option>Personal coaching</option>
							<option>Competition prep</option>
						</select>
					</div>
					<div>
						<label for="message" class="block font-mono text-xs uppercase tracking-[0.15em] text-void/60">Message</label>
						<textarea id="message" name="message" rows="4" class="mt-2 w-full rounded-sm border border-void/20 bg-chalk px-4 py-2.5 text-void placeholder:text-void/40 focus:border-green-ink focus:outline-none" placeholder="Anything we should know before you visit?"></textarea>
					</div>
					<button type="submit" class="w-full rounded-sm bg-green px-6 py-3 font-mono text-xs uppercase tracking-[0.15em] text-void transition-colors hover:bg-green-dim">
						Send
					</button>
					<p id="form-status" class="hidden font-mono text-xs uppercase tracking-[0.15em] text-green-ink" role="status"></p>
				</form>
			</div>
		</div>
	</section>
</Layout>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement | null;
	const status = document.getElementById('form-status');
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (status) {
			status.textContent = 'Booked — we\'ll reply within a day.';
			status.classList.remove('hidden');
		}
		form.reset();
	});
</script>
