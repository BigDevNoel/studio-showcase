---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';

import loadingDockImg from '../assets/images/loading-dock-entrance.jpg';
import trainingFloorImg from '../assets/images/training-floor-brick-trusses.jpg';
import deadliftPlatformImg from '../assets/images/deadlift-platform-2.jpg';
import chalkHandsImg from '../assets/images/chalk-hands-before-lift.jpg';
import plateWallImg from '../assets/images/plate-wall-calibrated-bumpers.jpg';
import coachedSessionImg from '../assets/images/coach-marcus-technique-check.jpg';
import meetDayImg from '../assets/images/meet-day-focus-competition.jpg';
import ironPlatesImg from '../assets/images/iron-plates-full-range.jpg';
import firstPullImg from '../assets/images/first-pull-off-floor.jpg';
import kettlebellRackImg from '../assets/images/kettlebell-rack-accessory-corner.jpg';
import gripPrepImg from '../assets/images/grip-prep-between-sets.jpg';
import loadingSetImg from '../assets/images/loading-working-set.jpg';

const photos = [
	{ img: loadingDockImg, caption: 'Butler Street entrance, the original loading dock', h: 380 },
	{ img: trainingFloorImg, caption: 'Training floor, west end, before opening', h: 460 },
	{ img: deadliftPlatformImg, caption: 'Deadlift work, Platform 2', h: 420 },
	{ img: chalkHandsImg, caption: 'Chalk before a heavy set', h: 340 },
	{ img: plateWallImg, caption: 'Plate wall, calibrated bumpers', h: 460 },
	{ img: coachedSessionImg, caption: 'Coached session, technique check', h: 400 },
	{ img: meetDayImg, caption: 'Meet-day focus, USAPL local', h: 460 },
	{ img: ironPlatesImg, caption: 'Iron plates, full range 2.5–55 lb', h: 340 },
	{ img: firstPullImg, caption: 'First pull off the floor', h: 420 },
	{ img: kettlebellRackImg, caption: 'Bar and kettlebell rack, accessory corner', h: 340 },
	{ img: gripPrepImg, caption: 'Grip prep between sets', h: 380 },
	{ img: loadingSetImg, caption: 'Loading for a working set', h: 400 },
];
---

<Layout
	title="Gallery"
	description="Photos from the training floor at The Foundry Barbell Club — Lawrenceville, Pittsburgh."
>
	<section class="mx-auto max-w-6xl px-6 pt-16 pb-10 sm:pt-24">
		<p class="font-mono text-xs uppercase tracking-[0.3em] text-green">Gallery</p>
		<h1 class="mt-3 max-w-2xl font-display text-4xl uppercase leading-[0.95] tracking-tight text-chalk sm:text-6xl">
			The floor, on a normal week.
		</h1>
		<p class="mt-6 max-w-xl text-base leading-relaxed text-chalk-dim sm:text-lg">
			No staged shots &mdash; this is what training here actually looks like.
		</p>
	</section>

	<section class="mx-auto max-w-6xl px-6 py-10 pb-20">
		<div class="columns-1 gap-5 sm:columns-2 lg:columns-3">
			{
				photos.map((p, i) => (
					<div class="flash-reveal mb-5 break-inside-avoid" style={`transition-delay: ${(i % 6) * 70}ms`}>
						<div class="viewfinder overflow-hidden rounded-md">
							<Image
								src={p.img}
								alt={p.caption}
								class="w-full object-cover"
								style={`height: ${p.h}px;`}
								widths={[400, 700, 900]}
								sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
								loading="lazy"
							/>
							<span class="vf-corner"></span>
							<span class="vf-corner"></span>
							<span class="vf-corner"></span>
							<span class="vf-corner"></span>
							<div class="vf-scan"></div>
						</div>
						<p class="mt-2 font-mono text-[11px] uppercase tracking-[0.1em] text-chalk-dim">{p.caption}</p>
					</div>
				))
			}
		</div>
	</section>

	<!-- CTA — this page's white-background section -->
	<section class="whiteboard py-16 sm:py-20">
		<div class="mx-auto max-w-3xl px-6 text-center">
			<p class="flash-reveal font-mono text-xs uppercase tracking-[0.3em] text-green-ink">Shot on the floor</p>
			<h2 class="flash-reveal mt-2 font-display text-2xl uppercase tracking-tight text-void sm:text-3xl">
				Want to see it for yourself?
			</h2>
			<p class="flash-reveal mt-3 text-sm text-void/70">
				Tours run daily during staffed hours &mdash; no camera required, but bring one if you want.
			</p>
			<a href="/contact" class="mt-7 inline-block rounded-sm bg-green px-7 py-3 font-mono text-xs uppercase tracking-[0.15em] text-void transition-colors hover:bg-green-dim">
				Book a Tour
			</a>
		</div>
	</section>
</Layout>
