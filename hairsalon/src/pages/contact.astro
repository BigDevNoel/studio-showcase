---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Contact"
	description="Book an appointment at Salt & Iron Salon + Spa — 142 Clingman Ave, Asheville, NC. Tue–Fri 9a–7p, Sat 9a–5p."
>
	<section class="mx-auto max-w-6xl px-6 py-20">
		<p class="font-mono text-xs uppercase tracking-[0.25em] text-temper-gold">Contact</p>
		<h1 class="mt-2 max-w-2xl font-display text-5xl font-bold uppercase leading-[0.95] tracking-tight text-ivory sm:text-6xl">
			Come find the door
		</h1>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-24">
		<div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr]">
			<div class="foil-reveal space-y-10">
				<div>
					<p class="font-mono text-xs uppercase tracking-[0.2em] text-steel">Address</p>
					<p class="mt-2 text-lg text-ivory">142 Clingman Ave<br />Asheville, NC 28801</p>
					<p class="mt-2 text-sm text-plaster">
						River Arts District, next to the old candle factory. Street parking on Clingman;
						overflow lot two doors down.
					</p>
				</div>
				<div>
					<p class="font-mono text-xs uppercase tracking-[0.2em] text-steel">Hours</p>
					<dl class="mt-2 space-y-1 font-mono text-sm text-plaster">
						<div class="flex justify-between gap-8"><dt>Tue&ndash;Fri</dt><dd>9:00a &ndash; 7:00p</dd></div>
						<div class="flex justify-between gap-8"><dt>Saturday</dt><dd>9:00a &ndash; 5:00p</dd></div>
						<div class="flex justify-between gap-8"><dt>Sun&ndash;Mon</dt><dd>Closed</dd></div>
					</dl>
				</div>
				<div>
					<p class="font-mono text-xs uppercase tracking-[0.2em] text-steel">Reach us</p>
					<p class="mt-2 text-lg">
						<a href="tel:+18285550142" class="text-ivory hover:text-temper-gold">(828) 555-0142</a>
					</p>
					<p class="text-lg">
						<a href="mailto:hello@saltandironavl.com" class="text-ivory hover:text-temper-gold"
							>hello@saltandironavl.com</a
						>
					</p>
					<p class="mt-2">
						<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="text-sm text-steel hover:text-temper-gold"
							>@saltandiron.avl</a
						>
					</p>
				</div>

				<div class="overflow-hidden rounded-md border border-steel-dark/40">
					<iframe
						title="Map to Salt & Iron Salon + Spa, 142 Clingman Ave, Asheville, NC"
						src="https://www.google.com/maps?q=142+Clingman+Ave,+Asheville,+NC+28801&output=embed"
						class="h-64 w-full grayscale-[0.3]"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
					></iframe>
				</div>
			</div>

			<div class="foil-reveal rounded-md border border-steel-dark/40 bg-graphite-2 p-8 sm:p-10" style="transition-delay:120ms">
				<h2 class="font-display text-2xl font-bold uppercase tracking-tight text-ivory">Request an appointment</h2>
				<p class="mt-2 text-sm text-steel">
					Tell us what you're after and preferred timing &mdash; we'll confirm by phone or email
					within a business day.
				</p>

				<form id="booking-form" class="mt-8 space-y-5" novalidate>
					<div class="grid gap-5 sm:grid-cols-2">
						<div>
							<label for="name" class="block font-mono text-xs uppercase tracking-[0.15em] text-steel">Name</label>
							<input
								id="name"
								name="name"
								type="text"
								required
								class="mt-2 w-full rounded-sm border border-steel-dark/60 bg-graphite px-4 py-3 text-ivory placeholder:text-steel/60 focus:border-temper-gold"
								placeholder="Jamie Rivers"
							/>
						</div>
						<div>
							<label for="phone" class="block font-mono text-xs uppercase tracking-[0.15em] text-steel">Phone</label>
							<input
								id="phone"
								name="phone"
								type="tel"
								required
								class="mt-2 w-full rounded-sm border border-steel-dark/60 bg-graphite px-4 py-3 text-ivory placeholder:text-steel/60 focus:border-temper-gold"
								placeholder="(828) 555-0100"
							/>
						</div>
					</div>

					<div>
						<label for="service" class="block font-mono text-xs uppercase tracking-[0.15em] text-steel">Service</label>
						<select
							id="service"
							name="service"
							class="mt-2 w-full rounded-sm border border-steel-dark/60 bg-graphite px-4 py-3 text-ivory focus:border-temper-gold"
						>
							<option>Cut / Barbering</option>
							<option>Color / Highlights</option>
							<option>Facial / Spa</option>
							<option>Not sure yet</option>
						</select>
					</div>

					<div>
						<label for="message" class="block font-mono text-xs uppercase tracking-[0.15em] text-steel">
							What's going on, and when works?
						</label>
						<textarea
							id="message"
							name="message"
							rows="4"
							required
							class="mt-2 w-full rounded-sm border border-steel-dark/60 bg-graphite px-4 py-3 text-ivory placeholder:text-steel/60 focus:border-temper-gold"
							placeholder="Growing out a box dye, hoping for something low-maintenance. Weekday afternoons are easiest."
						></textarea>
					</div>

					<button
						type="submit"
						class="w-full rounded-sm bg-temper-gold px-6 py-3 font-mono text-sm uppercase tracking-[0.15em] text-graphite transition-transform hover:-translate-y-0.5 sm:w-auto"
					>
						Send request
					</button>

					<p id="form-status" class="hidden font-mono text-sm text-temper-gold" role="status"></p>
				</form>
			</div>
		</div>
	</section>
</Layout>

<script>
	const form = document.getElementById('booking-form') as HTMLFormElement | null;
	const status = document.getElementById('form-status');
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		if (!form.checkValidity()) {
			form.reportValidity();
			return;
		}
		form.reset();
		if (status) {
			status.textContent = 'Request received — we\'ll call or email to confirm.';
			status.classList.remove('hidden');
		}
	});
</script>
