---
import Layout from '../layouts/Layout.astro';
import TiltPhoto from '../components/TiltPhoto.astro';

import colorClient from '../assets/images/color-application-client.jpg';
import clippers from '../assets/images/clippers-closeup.jpg';
import claymask from '../assets/images/facial-clay-mask-removal.jpg';

const menus = [
	{
		id: 'hair',
		title: 'Cut & Barbering',
		intro: 'Every cut is a consultation first — we ask what your hair actually does on day three, not day one.',
		img: clippers,
		alt: 'Close-up of clippers during a haircut',
		items: [
			{ name: "Women's Cut & Style", price: '$68' },
			{ name: "Men's Cut", price: '$42' },
			{ name: 'Buzz / Fade', price: '$38' },
			{ name: 'Beard Trim & Hot Towel', price: '$28' },
			{ name: 'Cut + Beard Combo', price: '$58' },
			{ name: 'Hot Towel Straight Razor Shave', price: '$48' },
			{ name: 'Blowout & Style', price: '$48' },
			{ name: "Kids Cut (12 & under)", price: '$30' },
		],
	},
	{
		id: 'color',
		title: 'Color & Highlights',
		intro: 'Mixed at the bench for your skin tone and hair history — swatch books are a starting point, not the answer.',
		img: colorClient,
		alt: 'Client receiving hair color application',
		items: [
			{ name: 'Root Touch-Up (single process)', price: '$95' },
			{ name: 'All-Over Color', price: '$135' },
			{ name: 'Foil Highlight, Partial', price: '$145' },
			{ name: 'Foil Highlight, Full', price: '$195' },
			{ name: 'Balayage, Partial', price: '$175' },
			{ name: 'Balayage, Full', price: '$225' },
			{ name: 'Fashion Color / Vivid', price: 'from $160' },
			{ name: 'Gloss / Toner', price: '$45' },
			{ name: 'Keratin Smoothing Treatment', price: '$275' },
		],
	},
	{
		id: 'spa',
		title: 'Facials & Spa',
		intro: 'Skin treatments built around what your skin is doing this season, run by a licensed esthetician.',
		img: claymask,
		alt: 'Esthetician removing a clay facial mask',
		items: [
			{ name: 'Signature Facial (60 min)', price: '$110' },
			{ name: 'Express Facial (30 min)', price: '$65' },
			{ name: 'Brow Shape', price: '$22' },
			{ name: 'Lip or Chin Wax', price: '$15' },
			{ name: 'Scalp Treatment & Massage', price: '$35' },
			{ name: 'Hand & Arm Massage Add-On', price: '$30' },
			{ name: 'Deep Conditioning Add-On', price: '$25' },
		],
	},
];
---

<Layout
	title="Services"
	description="Full service menu and pricing for Salt & Iron Salon + Spa — cuts, color, barbering, and facials in Asheville's River Arts District."
>
	<section class="mx-auto max-w-6xl px-6 py-20">
		<p class="font-mono text-xs uppercase tracking-[0.25em] text-temper-gold">Menu</p>
		<h1 class="mt-2 max-w-2xl font-display text-5xl font-bold uppercase leading-[0.95] tracking-tight text-ivory sm:text-6xl">
			Services &amp; pricing
		</h1>
		<p class="mt-6 max-w-xl text-lg text-plaster">
			Prices reflect service length and product, not who's sitting in the chair. New guests,
			add fifteen minutes for a consult — first appointment always starts there.
		</p>
	</section>

	{
		menus.map((menu, mi) => (
			<>
				<section id={menu.id} class="scroll-mt-24 border-t border-steel-dark/40 py-16">
					<div class="mx-auto max-w-6xl px-6">
						<div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
							<div class="foil-reveal lg:sticky lg:top-28">
								<TiltPhoto src={menu.img} alt={menu.alt} aspect="aspect-[4/3]" priority={mi === 0} />
								<h2 class="mt-6 font-display text-3xl font-bold uppercase tracking-tight text-ivory sm:text-4xl">
									{menu.title}
								</h2>
								<p class="mt-3 text-sm leading-relaxed text-steel">{menu.intro}</p>
							</div>

							<ul class="divide-y divide-steel-dark/40">
								{menu.items.map((item, ii) => (
									<li
										class="foil-reveal flex items-baseline justify-between gap-4 py-4"
										style={`transition-delay:${ii * 40}ms`}
									>
										<span class="text-plaster">{item.name}</span>
										<span class="font-mono text-sm text-temper-gold whitespace-nowrap">{item.price}</span>
									</li>
								))}
							</ul>
						</div>
					</div>
				</section>
			</>
		))
	}

	<section class="bg-graphite-2 py-16">
		<div class="mx-auto max-w-6xl px-6 text-center">
			<h2 class="font-display text-3xl font-bold uppercase tracking-tight text-ivory sm:text-4xl">
				Not sure where to start?
			</h2>
			<p class="mx-auto mt-4 max-w-xl text-plaster">
				Tell us what's going on with your hair or skin and we'll build the appointment around it.
			</p>
			<a
				href="/contact"
				class="mt-8 inline-block rounded-sm bg-temper-gold px-6 py-3 font-mono text-sm uppercase tracking-[0.15em] text-graphite transition-transform hover:-translate-y-0.5"
			>
				Book an appointment
			</a>
		</div>
	</section>
</Layout>
