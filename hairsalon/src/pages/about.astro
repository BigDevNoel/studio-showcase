---
import Layout from '../layouts/Layout.astro';
import TiltPhoto from '../components/TiltPhoto.astro';

import warehouse from '../assets/images/brick-warehouse-exterior.jpg';
import interiorContemporary from '../assets/images/barbershop-interior-contemporary.jpg';
import femalePortrait from '../assets/images/female-barber-portrait.jpg';
import malePortrait from '../assets/images/male-hairdresser-portrait.jpg';
import jadeRoller from '../assets/images/facial-jade-roller.jpg';

const team = [
	{
		name: 'Reva Odom',
		role: 'Co-Owner &middot; Master Colorist',
		bio: 'Eight years cutting her teeth at a color-only studio in Brooklyn before moving home to Asheville. Specializes in balayage and correcting box-dye color gone sideways.',
		img: femalePortrait,
		alt: 'Reva Odom, co-owner and master colorist',
	},
	{
		name: 'Dez Calloway',
		role: 'Co-Owner &middot; Barber',
		bio: 'Apprenticed for six years under his uncle at a Charlotte barbershop. Runs the barbering side and still does every straight-razor shave on the books personally.',
		img: malePortrait,
		alt: 'Dez Calloway, co-owner and barber',
	},
	{
		name: 'Priya Nair',
		role: 'Lead Esthetician',
		bio: 'Licensed esthetician who joined in 2019 to open the spa room. Trained in clinical facials and treats skin like it changes with the seasons — because it does.',
		img: jadeRoller,
		alt: 'Facial treatment using a jade roller',
	},
];
---

<Layout
	title="About"
	description="Salt & Iron was founded in 2016 by colorist Reva Odom and barber Dez Calloway inside a former metal fabrication shop in Asheville's River Arts District."
>
	<section class="mx-auto max-w-6xl px-6 py-20">
		<p class="font-mono text-xs uppercase tracking-[0.25em] text-temper-gold">Our story</p>
		<h1 class="mt-2 max-w-3xl font-display text-5xl font-bold uppercase leading-[0.95] tracking-tight text-ivory sm:text-6xl">
			We kept the loading door
		</h1>
	</section>

	<section class="mx-auto max-w-6xl px-6 pb-20">
		<div class="grid items-start gap-14 lg:grid-cols-2">
			<TiltPhoto src={warehouse} alt="The converted brick warehouse building on Clingman Ave" aspect="aspect-[4/3]" priority />
			<div class="foil-reveal space-y-5 text-lg leading-relaxed text-plaster">
				<p>
					From 1961 to 2015, 142 Clingman Ave was <strong class="text-ivory">Coxe Avenue Metal
					Works</strong>, a fabrication shop that bent rebar, ductwork, and the occasional
					sculpture commission for half of downtown Asheville. When the owner retired and the
					River Arts District started filling with studios, the building sat empty for a year.
				</p>
				<p>
					Reva Odom and Dez Calloway met in 2015 at a regional stylist conference in Charlotte,
					both venting about the same thing: salons and barbershops that treated men's and
					women's services like two different businesses under one roof. They pooled savings,
					signed the lease in early 2016, and spent four months sandblasting brick and rewiring
					the place themselves before opening that June.
				</p>
				<p>
					They kept what they could &mdash; the steel roll-up loading door is still the front
					entrance, the ceiling trusses are original, and the name is a nod to what the building
					used to make hot. Ten years later, it still runs on the same idea: one floor, every
					service, no side of the shop that's off-limits to anyone.
				</p>
			</div>
		</div>
	</section>

	<div class="steel-rail mx-auto max-w-6xl"></div>

	<section class="mx-auto max-w-6xl px-6 py-20">
		<p class="font-mono text-xs uppercase tracking-[0.25em] text-temper-gold">The people</p>
		<h2 class="mt-2 font-display text-4xl font-bold uppercase tracking-tight text-ivory sm:text-5xl">
			Three chairs, three specialties
		</h2>

		<div class="mt-12 grid gap-12 sm:grid-cols-3">
			{
				team.map((person, i) => (
					<div class="foil-reveal" style={`transition-delay:${i * 90}ms`}>
						<TiltPhoto src={person.img} alt={person.alt} aspect="aspect-[3/4]" />
						<h3 class="mt-5 font-display text-2xl font-semibold text-ivory">{person.name}</h3>
						<p class="mt-1 font-mono text-xs uppercase tracking-[0.15em] text-temper-gold" set:html={person.role} />
						<p class="mt-3 text-sm leading-relaxed text-steel">{person.bio}</p>
					</div>
				))
			}
		</div>
	</section>

	<section class="bg-graphite-2 py-20">
		<div class="mx-auto grid max-w-6xl items-center gap-14 px-6 lg:grid-cols-2">
			<div class="foil-reveal order-2 lg:order-1">
				<h2 class="font-display text-4xl font-bold uppercase tracking-tight text-ivory sm:text-5xl">
					Still a working shop
				</h2>
				<p class="mt-4 text-lg leading-relaxed text-plaster">
					The original steel I-beams still run the length of the ceiling, and we left one wall
					of pegboard from the old shop &mdash; now it holds shears and combs instead of C-clamps.
					Every color service is mixed at a station bolted to a workbench that used to hold a
					welding rig.
				</p>
				<a
					href="/contact"
					class="mt-6 inline-block font-mono text-xs uppercase tracking-[0.15em] text-temper-gold hover:underline"
				>
					Get directions &rarr;
				</a>
			</div>
			<div class="order-1 lg:order-2">
				<TiltPhoto src={interiorContemporary} alt="Interior of the studio showing chairs and mirrors" aspect="aspect-[4/3]" />
			</div>
		</div>
	</section>
</Layout>
